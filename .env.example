# Copy to .env.local for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables (Production).

# Canonical site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://medregbiotox.com

# --- Enquiry form delivery (configure at least one) ---
# Email through Resend (https://resend.com). Verify medregbiotox.com in Resend to send from your own domain.
RESEND_API_KEY=
LEAD_FROM_EMAIL=BIOTOX Website <website@medregbiotox.com>
LEAD_TO_EMAIL=enquiry@medregbiotox.com
# Optional: also POST each enquiry as JSON to Google Sheets (Apps Script), Zapier, Make, Slack or a CRM.
# For Google Sheets, deploy scripts/enquiry-sheet.gs and use the same secret there.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Confirmation email to the visitor (needs RESEND_API_KEY and medregbiotox.com verified in Resend)
AUTOREPLY_FROM=BIOTOX by MedReg <enquiry@medregbiotox.com>
